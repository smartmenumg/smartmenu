# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT ENVIRONMENT
# Copy this file to .env.local — used ONLY for local development
# ─────────────────────────────────────────────────────────────────────────────
# RULES:
#   - .env.local is git-ignored — NEVER commit it
#   - All values here point to the DEV Supabase project and Razorpay TEST mode
#   - Production secrets MUST NEVER appear here
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# ── Supabase — DEV PROJECT (never use production keys here) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# Used by Supabase CLI for migrations against the dev project
SUPABASE_PROJECT_ID=YOUR_DEV_PROJECT_ID
SUPABASE_DB_PASSWORD=YOUR_DEV_DB_PASSWORD

# ── Razorpay — TEST MODE ONLY (key starts with rzp_test_) ────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET

# Webhook URL for local dev (use ngrok or smee.io to expose localhost)
# Example: https://abc123.ngrok.io/api/webhooks/razorpay
# RAZORPAY_WEBHOOK_URL=https://YOUR_NGROK_URL/api/webhooks/razorpay
